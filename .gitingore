# Build Tools (Maven and Gradle)
# =========================================================================
*.md
target/
build/
out/
.gradle/
bin/
/buildSrc/build
/kotlin/
.gradletasknamecache
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
